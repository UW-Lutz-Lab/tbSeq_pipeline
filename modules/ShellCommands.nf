
// ======================
// BcftoolsConcat
// ======================
/*
 * Concatenates VCF files, adds an explicit INFO/TYPE tag for SNP/INDEL,
 * and produces both compressed and uncompressed output VCFs.
 *
 * Args:
 *   vcfs (List): List of compressed VCF file paths (e.g., SNP and INDEL VCFs).
 *   read_alias (String): Prefix for the output files.
 *
 * Output:
 *   ${read_alias}.vcf.gz        - merged VCF, compressed
 *   ${read_alias}_final.vcf.gz  - merged VCF with TYPE tag, compressed
 *   ${read_alias}_final.vcf     - merged VCF with TYPE tag, uncompressed
 */
def BcftoolsConcat(vcfs, read_alias) {
    """
    bcftools concat -a ${vcfs.join(' ')} -Oz -o ${read_alias}.vcf.gz
    bcftools +fill-tags ${read_alias}.vcf.gz -- -t TYPE -o ${read_alias}_final.vcf.gz -Oz
    gunzip -c ${read_alias}_final.vcf.gz > ${read_alias}_final.vcf
    """.stripIndent().trim()
}

// ======================
// TabixVCF
// ======================
/*
 * Indexes a bgzipped VCF file using tabix, enabling fast random access
 * and compatibility with tools such as bcftools, IGV, and others.
 *
 * Args:
 *   vcf (String): Path to the bgzipped VCF file (should end with .vcf.gz).
 *
 * Output:
 *   ${vcf}.tbi - Tabix index file created alongside the input VCF.
 *
 * Assumptions:
 *   - Input VCF is bgzipped (.vcf.gz).
 *   - tabix is available in the PATH.
 */
def TabixVCF(
    vcf
) {
    return "tabix -p vcf ${vcf}"
}

// ======================
// VarscanMpileup2Indel
// ======================
/*
 * Calls INDEL variants from a pileup file using VarScan2 and outputs
 * a bgzipped VCF file suitable for downstream analysis.
 *
 * Args:
 *   mpileup (String): Path to the input pileup file (SAMtools pileup format).
 *   output_tag (String): Prefix or tag for the output file.
 *
 * Output:
 *   ${output_tag}.vcf.gz - Compressed VCF file containing INDEL variant calls.
 *
 * Assumptions:
 *   - VarScan2 and bgzip are available in the PATH.
 *   - Input pileup is correctly formatted and compatible with VarScan2.
 */
def VarscanMpileup2Indel(
    mpileup,
    output_tag
) {
    return """
    varscan mpileup2indel "${mpileup}" \
        --min-var-freq 0.001 \
        --min-reads2 2 \
        --min-coverage 10 \
        --p-value 0.01 \
        --output-vcf 1 | bgzip -c > "${output_tag}.vcf.gz"
    """.stripIndent().trim()
}

