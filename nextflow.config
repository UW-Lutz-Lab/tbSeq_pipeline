// nextflow.config

// File Paths
// NOTE:
// IF using docker, keep the /mnt/ path for proper function
params {
    outdir = '/mnt/processed_results' // Output directory
    reference_base_dir = "/mnt/references" //name of reference fasta
    base_dir = '/mnt/reads' //base directory of reads
    samplesheet = "/mnt/sample_sheet.csv" //file name of sample sheet
}

// Quality and Length Filtering
params {
    minlength = 10 // min length filter
    maxlength = 500 // max length filter
    min_quality_filter = 30 // min qual filter >=
    max_quality_filter = 40 // max qual filter
}

// Alignment options
params {
    alignment_type = 'bowtie2'  // minimap2 or bowtie2
    alignment_settings = [
        minimap2: [ k: 7, w: 3 ],
        bowtie2: [  ]
    ]
}

// Variant Calling options
params {
    min_gq = 20  // Minimum genotype quality (GQ) for variant calls.
    min_var_freq = 0.001 // Minimum variant allele frequency (%) required to call a variant.
    min_coverage = 10 // Minimum total read depth at a position to consider for variant calling.
}



// Default process settings
process {
    executor = 'local' // Use the local executor
    memory = { "${(Runtime.runtime.maxMemory() / (1024 * 1024)).intValue()} MB" } // Use available memory
    cpus = { Runtime.runtime.availableProcessors() }          // Default number of CPUs
}



